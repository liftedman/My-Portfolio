# Canonical origin for sitemap, robots and absolute OG image URLs.
# Without it the app falls back to Vercel's per-deployment URL, which changes
# on every deploy, and to localhost when running locally.
# Set this in the Vercel dashboard under Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://my-portfolio-deeu.vercel.app

# Resend API key for the contact form (app/api/contact).
# Without it the form returns a 500 with a "not configured" message.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# --- Sanity CMS (content editing at /studio) — see CMS.md ---
# From sanity.io/manage → your project. Public values, safe to expose.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed on your computer, once, for `npm run sanity:import`.
# sanity.io/manage → API → Tokens → Add API token (Editor). Do NOT add to Vercel.
SANITY_API_WRITE_TOKEN=

# Optional: makes edits go live in seconds instead of within a minute.
# Any long random string; the same value goes in the Sanity webhook's "Secret".
SANITY_REVALIDATE_SECRET=
