# Canonical origin for sitemap, robots and absolute OG image URLs.
# Without it the app falls back to Vercel's per-deployment URL, which changes
# on every deploy, and to localhost when running locally.
# Set this in the Vercel dashboard under Settings > Environment Variables.
NEXT_PUBLIC_SITE_URL=https://my-portfolio-deeu.vercel.app

# Resend API key for the contact form (app/api/contact).
# Without it the form returns a 500 with a "not configured" message.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=
